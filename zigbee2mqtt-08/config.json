{
  "name": "08_Симфер",
  "version": "2.14.1-2",
  "slug": "zigbee2mqtt_08",
  "description": "Zigbee2MQTT Instance #08 with isolated config folder and Web UI",
  "url": "https://github.com/Koenkk/zigbee2mqtt",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:zigbee",
  "uart": true,
  "udev": true,
  "services": [
    "mqtt:need"
  ],
  "hassio_api": true,
  "map": [
    {
      "type": "share",
      "read_only": false
    },
    {
      "type": "homeassistant_config",
      "read_only": false,
      "path": "/config"
    },
    {
      "type": "addon_config",
      "read_only": false,
      "path": "/addon_config"
    }
  ],
  "ports": {
    "8408/tcp": null
  },
  "ports_description": {
    "8408/tcp": "Socat tcp-listen port for instance #08"
  },
  "options": {
    "data_path": "/config/z2m_simpheropol",
    "socat": {
      "enabled": false,
      "master": "pty,raw,echo=0,link=/tmp/ttyZ2M_08,mode=777",
      "slave": "tcp-listen:8408,keepalive,nodelay,reuseaddr,keepidle=1,keepintvl=1,keepcnt=5",
      "options": "-d -d",
      "log": false
    },
    "mqtt": {
      "base_topic": "z2m_simpheropol"
    },
    "serial": {
      "port": "tcp://10.12.21.190:8888",
      "adapter": "zstack"
    }
  },
  "schema": {
    "data_path": "str",
    "socat": {
      "enabled": "bool?",
      "master": "str?",
      "slave": "str?",
      "options": "str?",
      "log": "bool?"
    },
    "mqtt": {
      "server": "str?",
      "ca": "str?",
      "key": "str?",
      "cert": "str?",
      "user": "str?",
      "password": "str?",
      "base_topic": "str?"
    },
    "serial": {
      "port": "str?",
      "adapter": "match(zstack|deconz|zigate|ezsp|ember|zboss)?",
      "baudrate": "int?",
      "rtscts": "bool?"
    },
    "watchdog": "str?",
    "force_onboarding": "bool?"
  },
  "image": "ghcr.io/zigbee2mqtt/zigbee2mqtt-{arch}"
}
