{
  "name": "Zigbee2MQTT #13",
  "version": "2.14.1-1",
  "slug": "zigbee2mqtt_13",
  "description": "Zigbee2MQTT Instance #13 with isolated config folder and Web UI",
  "url": "https://github.com/Koenkk/zigbee2mqtt",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "ingress": true,
  "ingress_port": 8103,
  "panel_icon": "mdi:zigbee",
  "uart": true,
  "udev": true,
  "services": [
    "mqtt:need"
  ],
  "hassio_api": true,
  "map": [
    {
      "type": "share",
      "read_only": false
    },
    {
      "type": "homeassistant_config",
      "read_only": false,
      "path": "/config"
    },
    {
      "type": "addon_config",
      "read_only": false,
      "path": "/addon_config"
    }
  ],
  "ports": {
    "8493/tcp": 8493,
    "8103/tcp": null
  },
  "ports_description": {
    "8493/tcp": "Socat tcp-listen port for instance #13",
    "8103/tcp": "Frontend port for instance #13"
  },
  "options": {
    "data_path": "/config/zigbee2mqtt_13",
    "socat": {
      "enabled": false,
      "master": "pty,raw,echo=0,link=/tmp/ttyZ2M_13,mode=777",
      "slave": "tcp-listen:8493,keepalive,nodelay,reuseaddr,keepidle=1,keepintvl=1,keepcnt=5",
      "options": "-d -d",
      "log": false
    },
    "mqtt": {
      "base_topic": "zigbee2mqtt_13"
    },
    "serial": {}
  },
  "schema": {
    "data_path": "str",
    "socat": {
      "enabled": "bool?",
      "master": "str?",
      "slave": "str?",
      "options": "str?",
      "log": "bool?"
    },
    "mqtt": {
      "server": "str?",
      "ca": "str?",
      "key": "str?",
      "cert": "str?",
      "user": "str?",
      "password": "str?",
      "base_topic": "str?"
    },
    "serial": {
      "port": "str?",
      "adapter": "match(zstack|deconz|zigate|ezsp|ember|zboss)?",
      "baudrate": "int?",
      "rtscts": "bool?"
    },
    "watchdog": "str?",
    "force_onboarding": "bool?"
  },
  "image": "ghcr.io/zigbee2mqtt/zigbee2mqtt-{arch}"
}